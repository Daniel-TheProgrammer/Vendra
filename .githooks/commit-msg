#!/usr/bin/env sh
#
# Enforces Conventional Commits on the subject line:
#   <type>(<scope>)!: <summary>
# where <type> is one of the list below, <scope> is optional and lower-case
# (use the module name), and <summary> is at most 72 characters.
#
# Merge and revert commits generated by git are accepted as-is.

set -eu

msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|perf|test|docs|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].{0,71}$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    cat >&2 <<EOF
commit-msg: subject line does not follow Conventional Commits.

  got:      $subject
  expected: <type>(<scope>): <summary>
  types:    feat fix refactor perf test docs build ci chore revert
  example:  feat(orders): reserve stock when an order is placed

EOF
    exit 1
fi
