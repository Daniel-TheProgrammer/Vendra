APP_NAME=Vendra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id

# Client application that renders password-reset links.
FRONTEND_URL=http://localhost:3000

# Identity: token lifetime and login throttling.
IDENTITY_TOKEN_TTL_DAYS=30
IDENTITY_TOKEN_MAX_TTL_DAYS=365
IDENTITY_LOGIN_ATTEMPTS_PER_MINUTE=5

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (service name "postgres" inside the Compose network).
# DB_USERNAME is the restricted application role (no superuser, no RLS bypass).
# DB_ADMIN_* is the superuser used by Compose to initialise the server and by
# the pgsql_admin connection for deliberate cross-tenant work from the console.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=secret
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=secret

# Redis backs cache, queues, sessions, rate limiting and locks.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mailpit captures all outgoing mail locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@vendra.local"
MAIL_FROM_NAME="${APP_NAME}"

# Meilisearch master key (any string locally; generate a real one for servers).
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=local-master-key-change-me

# Payments (docs/payments.md). "fake" needs no network; "stripe" needs a
# test-mode key (sk_test_…). Live keys are refused.
PAYMENTS_GATEWAY=fake
STRIPE_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Host ports for services exposed by compose.override.yaml.
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MEILISEARCH_PORT=7700
FORWARD_MAILPIT_PORT=8025
